# Local MySQL only — must start with mysql:// (never prisma:// Accelerate URLs).
DATABASE_URL="mysql://root:password@localhost:3306/qeema_db"

# Required for JWT — use a long random string (e.g. openssl rand -hex 32)
SECRET_KEY="replace-with-long-random-secret"
JWT_EXPIRES_IN=7d
PORT=3000
CORS_ORIGIN=

# Optional seed (see src/bootstrap/seed.ts)
# SEED_ADMIN_EMAIL=admin@qeema.local
# SEED_ADMIN_PASSWORD=Admin123!
# SEED_DISABLE=true
